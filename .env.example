# PocketBase Configuration
VITE_POCKETBASE_URL=http://127.0.0.1:8090

# Development settings
VITE_APP_NAME=SiteWise
VITE_APP_ENV=development

# Cloudflare Turnstile Configuration (web bot protection)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# Native app attestation (Tauri desktop/mobile bot protection)
# Turnstile cannot render inside a native webview, so native builds sign auth
# requests with an HMAC derived from this shared secret. It must match the
# PocketBase server's APP_ATTEST_SECRET. Leave blank for web-only/dev; set it
# (via CI secret VITE_APP_ATTEST_SECRET) for any native build that must log in.
VITE_APP_ATTEST_SECRET=